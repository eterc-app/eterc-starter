# Generate a new value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ET_SECRET=""

# SQLite is the bundled runtime database. Keep this path on a persistent disk.
# ET_SQLITE_FILE="prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Optional: set when the app is served from a sub-path.
# ET_BASE_URL="/"

# Set to 1 to allow Settings -> Write .env in production.
# ET_ALLOW_ENV_WRITE="0"
