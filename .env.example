# Generate a new value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ET_SECRET=""

# SQLite is the bundled runtime database. Keep this path on a persistent disk.
# ET_SQLITE_FILE="prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Optional: set when the app is served from a sub-path.
# ET_BASE_URL="/"

# Local-only runtime written by Eterc Desktop. Vercel remains blocked.
ET_STACK_VERSION=3
ET_FRAMEWORK_PROVIDER=nextjs
ET_AUTH_PROVIDER=builtin
ET_DATABASE_PROVIDER=sqlite
ET_ORM_PROVIDER=raw-sql
ET_CACHE_PROVIDER=memory
ET_JOBS_PROVIDER=immediate
ET_STORAGE_PROVIDER=local
ET_DEPLOYMENT_PROVIDER=local

# Flow runtime. embedded runs the scheduler in this process; worker expects an
# external timer to call /api/flows/worker with FLOW_CRON_SECRET.
FLOWS_ENABLED=1
FLOW_RUNTIME=embedded
FLOWS_SCHEDULER=in-process
# Required by /api/flows/cron and /api/flows/worker in every non-development
# deployment. Generate with the command above.
FLOW_CRON_SECRET=""
# Stable HMAC key for webhook secrets. If omitted, a local file is generated.
ETERC_FLOW_SECRET=""
# Public base URL used for generated webhook links.
# FLOW_PUBLIC_URL="https://cms.example.com"
FLOW_LOGS_RETENTION_DAYS=90
