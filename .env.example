# Generate a new value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ET_SECRET=""

# SQLite is the bundled runtime database. Keep this path on a persistent disk.
# ET_SQLITE_FILE="prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Optional: set when the app is served from a sub-path.
# ET_BASE_URL="/"

# Local-only runtime written by Eterc Desktop. Cloud providers are not
# supported in this release.
ET_STACK_VERSION=2
ET_FRAMEWORK_PROVIDER=nextjs
ET_AUTH_PROVIDER=builtin
ET_DATABASE_PROVIDER=sqlite
ET_ORM_PROVIDER=raw-sql
ET_CACHE_PROVIDER=memory
ET_JOBS_PROVIDER=immediate
ET_STORAGE_PROVIDER=local
ET_DEPLOYMENT_PROVIDER=local
